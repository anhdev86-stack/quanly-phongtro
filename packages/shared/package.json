{
  "name": "@ql-tro/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schema, enum, mã lỗi, mã permission dùng chung giữa api và web. Không chứa logic tính tiền.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vite": "8.3.2",
    "@types/node": "26.6.4"
  }
}
