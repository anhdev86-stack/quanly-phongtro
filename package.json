{
  "name": "ql-tro",
  "private": true,
  "description": "Phần mềm quản lý nhà trọ — monorepo (xem MASTER_PLAN.md)",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build:shared": "pnpm --filter @ql-tro/shared build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @ql-tro/api --filter @ql-tro/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm -r test",
    "test:integration": "pnpm build:shared && pnpm --filter @ql-tro/api test:integration",
    "test:e2e": "pnpm build:shared && pnpm --filter @ql-tro/e2e test:e2e",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @ql-tro/api db:migrate",
    "db:deploy": "pnpm --filter @ql-tro/api db:deploy",
    "db:seed": "pnpm --filter @ql-tro/api db:seed",
    "db:reset": "pnpm --filter @ql-tro/api db:reset",
    "db:bootstrap": "pnpm --filter @ql-tro/api db:bootstrap",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:restore:drill": "node scripts/db-restore.mjs --drill"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
