// Phase 2: người thuê, lần thuê, dịch vụ, đồng hồ, cọc, tiền giữ chỗ (MASTER_PLAN mục 6.3–6.6).

/// Bộ đếm số chứng từ/mã theo workspace, loại và kỳ (mã lần thuê, số thông báo…).
model DocumentSequence {
  workspaceId String @map("workspace_id") @db.Uuid
  kind        String
  period      String
  lastValue   Int    @default(0) @map("last_value")

  @@id([workspaceId, kind, period])
  @@map("document_sequences")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Tenant {
  id                  String    @id @default(uuid(7)) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  fullName            String    @map("full_name")
  birthDate           DateTime? @map("birth_date") @db.Date
  gender              Gender?
  phone               String?
  email               String?
  identityNumber      String?   @map("identity_number")
  issueDate           DateTime? @map("issue_date") @db.Date
  issuePlace          String?   @map("issue_place")
  permanentAddress    String?   @map("permanent_address")
  hometown            String?
  note                String?
  reminderOptIn       Boolean   @default(false) @map("reminder_opt_in")
  reminderConsentAt   DateTime? @map("reminder_consent_at") @db.Timestamptz(3)
  reminderConsentNote String?   @map("reminder_consent_note")
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(3)
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships TenancyTenant[]

  @@unique([id, workspaceId])
  @@index([workspaceId, fullName])
  @@index([workspaceId, identityNumber])
  @@map("tenants")
}

enum TenancyStatus {
  ACTIVE
  NOTICE_GIVEN
  MOVE_OUT_PROCESSING
  ENDED
}

/// Lần thuê — entity trung tâm (MASTER_PLAN 5.2). Một phòng chỉ có một tenancy chưa ENDED (partial unique, MANUAL_SQL.md).
model Tenancy {
  id                        String        @id @default(uuid(7)) @db.Uuid
  workspaceId               String        @map("workspace_id") @db.Uuid
  roomId                    String        @map("room_id") @db.Uuid
  code                      String
  startDate                 DateTime      @map("start_date") @db.Date
  chargeEndExclusive        DateTime?     @map("charge_end_exclusive") @db.Date
  actualMoveOutDate         DateTime?     @map("actual_move_out_date") @db.Date
  status                    TenancyStatus @default(ACTIVE)
  billingDueDay             Int           @default(5) @map("billing_due_day")
  initialDepositRequiredVnd BigInt        @default(0) @map("initial_deposit_required_vnd")
  noticeDaysSnapshot        Int           @default(30) @map("notice_days_snapshot")
  reservationId             String?       @map("reservation_id") @db.Uuid
  note                      String?
  createdBy                 String        @map("created_by") @db.Uuid
  version                   Int           @default(1)
  createdAt                 DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  room                Room                 @relation(fields: [roomId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  members             TenancyTenant[]
  rentPrices          RentPriceHistory[]
  services            TenancyService[]
  depositTransactions DepositTransaction[]
  readings            MeterReading[]
  contracts           Contract[]
  invoices            Invoice[]
  payments            Payment[]
  creditApplications  CreditApplication[]
  creditRefunds       CreditRefund[]

  @@unique([workspaceId, code])
  @@unique([id, workspaceId])
  @@index([roomId, status])
  @@map("tenancies")
}

enum MemberRole {
  PRIMARY
  MEMBER
}

enum ResidenceStatus {
  NOT_REGISTERED
  REGISTERED
  NOT_APPLICABLE
}

/// Thành viên của lần thuê theo khoảng [joined_on, left_on_exclusive). Đúng một PRIMARY đang ở (partial unique).
model TenancyTenant {
  id                    String          @id @default(uuid(7)) @db.Uuid
  workspaceId           String          @map("workspace_id") @db.Uuid
  tenancyId             String          @map("tenancy_id") @db.Uuid
  tenantId              String          @map("tenant_id") @db.Uuid
  role                  MemberRole
  joinedOn              DateTime        @map("joined_on") @db.Date
  leftOnExclusive       DateTime?       @map("left_on_exclusive") @db.Date
  residenceStatus       ResidenceStatus @default(NOT_REGISTERED) @map("residence_status")
  residenceRegisteredOn DateTime?       @map("residence_registered_on") @db.Date
  residenceNote         String?         @map("residence_note")
  version               Int             @default(1)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenancy Tenancy @relation(fields: [tenancyId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  tenant  Tenant  @relation(fields: [tenantId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@index([tenancyId])
  @@index([tenantId])
  @@map("tenancy_tenants")
}

enum VersionStatus {
  ACTIVE
  VOIDED
}

/// Lịch sử giá thuê theo ngày hiệu lực (MASTER_PLAN 4.4, D-022). Phiên bản từ hợp đồng có source_contract_id.
model RentPriceHistory {
  id               String        @id @default(uuid(7)) @db.Uuid
  tenancyId        String        @map("tenancy_id") @db.Uuid
  effectiveFrom    DateTime      @map("effective_from") @db.Date
  monthlyRentVnd   BigInt        @map("monthly_rent_vnd")
  sourceContractId String?       @map("source_contract_id") @db.Uuid
  reason           String?
  status           VersionStatus @default(ACTIVE)
  voidedAt         DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedBy         String?       @map("voided_by") @db.Uuid
  voidReason       String?       @map("void_reason")
  createdBy        String        @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenancy Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Restrict)

  @@index([tenancyId, effectiveFrom])
  @@map("rent_price_history")
}

enum ServiceType {
  FIXED_ROOM
  PER_PERSON
  QUANTITY
  METER
}

enum ChargeTiming {
  ADVANCE
  ARREARS
}

enum MeterType {
  ELECTRICITY
  WATER
}

model Service {
  id               String       @id @default(uuid(7)) @db.Uuid
  workspaceId      String       @map("workspace_id") @db.Uuid
  code             String
  name             String
  type             ServiceType
  unit             String
  chargeTiming     ChargeTiming @default(ADVANCE) @map("charge_timing")
  meterType        MeterType?   @map("meter_type")
  /// Dịch vụ không đồng hồ thay cho đồng hồ loại này (VD “Nước theo người” thay đồng hồ nước). Bật cùng đồng hồ phải xác nhận.
  substitutesMeter MeterType?   @map("substitutes_meter")
  archivedAt       DateTime?    @map("archived_at") @db.Timestamptz(3)
  version          Int          @default(1)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions TenancyService[]
  roomDefaults  RoomServiceDefault[]
  prices        ServicePriceHistory[]

  @@unique([workspaceId, code])
  @@map("services")
}

/// Subscription dịch vụ của lần thuê, có phiên bản theo ngày hiệu lực (MASTER_PLAN 6.4, D-024).
model TenancyService {
  id                    String        @id @default(uuid(7)) @db.Uuid
  tenancyId             String        @map("tenancy_id") @db.Uuid
  serviceId             String        @map("service_id") @db.Uuid
  effectiveFrom         DateTime      @map("effective_from") @db.Date
  endExclusive          DateTime?     @map("end_exclusive") @db.Date
  quantity              Decimal       @default(1) @db.Decimal(10, 2)
  billingPolicySnapshot Json?         @map("billing_policy_snapshot")
  sourceContractId      String?       @map("source_contract_id") @db.Uuid
  reason                String?
  status                VersionStatus @default(ACTIVE)
  voidedAt              DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedBy              String?       @map("voided_by") @db.Uuid
  voidReason            String?       @map("void_reason")
  createdBy             String        @map("created_by") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  tenancy Tenancy @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([tenancyId, serviceId])
  @@map("tenancy_services")
}

model RoomServiceDefault {
  roomId    String  @map("room_id") @db.Uuid
  serviceId String  @map("service_id") @db.Uuid
  quantity  Decimal @default(1) @db.Decimal(10, 2)

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([roomId, serviceId])
  @@map("room_service_defaults")
}

model Meter {
  id             String    @id @default(uuid(7)) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  roomId         String    @map("room_id") @db.Uuid
  type           MeterType
  serial         String?
  installedOn    DateTime  @map("installed_on") @db.Date
  retiredOn      DateTime? @map("retired_on") @db.Date
  initialReading Decimal   @map("initial_reading") @db.Decimal(12, 2)
  createdBy      String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  room     Room           @relation(fields: [roomId], references: [id], onDelete: Restrict)
  readings MeterReading[]
  events   MeterEvent[]

  @@index([roomId, type])
  @@map("meters")
}

enum ReadingKind {
  INITIAL
  PERIODIC
  FINAL
  /// Chỉ số chốt đồng hồ cũ khi thay đồng hồ (không phải mốc kỳ).
  CLOSING
}

model MeterReading {
  id                String      @id @default(uuid(7)) @db.Uuid
  meterId           String      @map("meter_id") @db.Uuid
  tenancyId         String?     @map("tenancy_id") @db.Uuid
  readOn            DateTime    @map("read_on") @db.Date
  value             Decimal     @db.Decimal(12, 2)
  kind              ReadingKind
  statementPeriodId String?     @map("statement_period_id") @db.Uuid
  note              String?
  version           Int         @default(1)
  createdBy         String      @map("created_by") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  meter           Meter            @relation(fields: [meterId], references: [id], onDelete: Restrict)
  tenancy         Tenancy?         @relation(fields: [tenancyId], references: [id], onDelete: Restrict)
  statementPeriod StatementPeriod? @relation(fields: [statementPeriodId], references: [id], onDelete: Restrict)

  @@unique([meterId, readOn])
  @@index([tenancyId])
  @@map("meter_readings")
}

enum MeterEventKind {
  REPLACEMENT
  CORRECTION
}

model MeterEvent {
  id        String         @id @default(uuid(7)) @db.Uuid
  meterId   String         @map("meter_id") @db.Uuid
  readingId String?        @map("reading_id") @db.Uuid
  kind      MeterEventKind
  reason    String
  oldValue  Decimal?       @map("old_value") @db.Decimal(12, 2)
  newValue  Decimal?       @map("new_value") @db.Decimal(12, 2)
  createdBy String         @map("created_by") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  meter Meter @relation(fields: [meterId], references: [id], onDelete: Restrict)

  @@index([meterId])
  @@map("meter_events")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  QR
  OTHER
}

enum DepositTxType {
  RECEIVED
  TOP_UP
  CONVERTED_FROM_HOLDING
  APPLIED_TO_INVOICE
  DEDUCTION
  REFUND
  REVERSAL
  TRANSFER_OUT
  TRANSFER_IN
}

/// Sổ cọc (MASTER_PLAN 9.2). amount_vnd luôn > 0; dấu suy ra từ loại; REVERSAL đảo dấu giao dịch gốc.
model DepositTransaction {
  id                         String         @id @default(uuid(7)) @db.Uuid
  workspaceId                String         @map("workspace_id") @db.Uuid
  tenancyId                  String         @map("tenancy_id") @db.Uuid
  type                       DepositTxType
  amountVnd                  BigInt         @map("amount_vnd")
  reason                     String?
  settlementId               String?        @map("settlement_id") @db.Uuid
  targetInvoiceId            String?        @map("target_invoice_id") @db.Uuid
  reversesTransactionId      String?        @unique @map("reverses_transaction_id") @db.Uuid
  linkedHoldingTransactionId String?        @map("linked_holding_transaction_id") @db.Uuid
  linkedDepositTransactionId String?        @map("linked_deposit_transaction_id") @db.Uuid
  paidAt                     DateTime?      @map("paid_at") @db.Date
  method                     PaymentMethod?
  reference                  String?
  createdBy                  String         @map("created_by") @db.Uuid
  createdAt                  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  tenancy     Tenancy             @relation(fields: [tenancyId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  allocations DepositAllocation[]

  @@index([tenancyId])
  @@map("deposit_transactions")
}

enum HoldingTxType {
  RECEIVED
  CONVERTED_TO_DEPOSIT
  REFUND
  FORFEIT
  REVERSAL
}

/// Sổ tiền giữ chỗ (MASTER_PLAN 9.3), tách khỏi sổ cọc.
model HoldingTransaction {
  id                         String         @id @default(uuid(7)) @db.Uuid
  workspaceId                String         @map("workspace_id") @db.Uuid
  reservationId              String         @map("reservation_id") @db.Uuid
  type                       HoldingTxType
  amountVnd                  BigInt         @map("amount_vnd")
  reason                     String?
  paidAt                     DateTime?      @map("paid_at") @db.Date
  method                     PaymentMethod?
  reference                  String?
  linkedDepositTransactionId String?        @map("linked_deposit_transaction_id") @db.Uuid
  reversesTransactionId      String?        @unique @map("reverses_transaction_id") @db.Uuid
  createdBy                  String         @map("created_by") @db.Uuid
  createdAt                  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@map("holding_transactions")
}
