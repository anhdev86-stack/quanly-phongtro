# Sao chép thành .env ở thư mục gốc rồi chỉnh giá trị. KHÔNG commit file .env.
# Mọi giá trị dưới đây chỉ dùng cho môi trường dev local, không phải bí mật thật.

NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=ql_tro
POSTGRES_PASSWORD=ql_tro_dev_only
POSTGRES_DB=ql_tro
# Cổng trên máy host. 5432/5433 hay bị PostgreSQL khác chiếm nên mặc định 55432.
POSTGRES_PORT=55432

DATABASE_URL=postgresql://ql_tro:ql_tro_dev_only@localhost:55432/ql_tro?schema=public
# Database riêng cho integration test (được tạo tự động lần đầu container khởi động).
DATABASE_URL_TEST=postgresql://ql_tro:ql_tro_dev_only@localhost:55432/ql_tro_test?schema=public

# --- API ---
API_PORT=4000
# Tối thiểu 32 ký tự. Production phải dùng giá trị ngẫu nhiên riêng.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# true khi chạy sau HTTPS (production).
COOKIE_SECURE=false
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
# Địa chỉ web công khai (ghép link xem thông báo trong tin nhắc đóng tiền).
PUBLIC_BASE_URL=http://localhost:3000

# --- Nhắc đóng tiền (MASTER_PLAN 9.7) ---
# Job chạy mỗi 15 phút. Ngoài production luôn chỉ ghi log (LogOnlyChannel), không gửi tin thật.
REMINDER_JOB_ENABLED=true
# Khóa nhà cung cấp: chủ trọ tự đăng ký và tự điền ở server production. KHÔNG điền ở đây, KHÔNG commit.
# ZALO_ZNS_ACCESS_TOKEN=
# ZALO_ZNS_TEMPLATE_ID=
# SMS_API_URL=
# SMS_API_KEY=
# SMS_BRANDNAME=

# --- Tự động ghi nhận chuyển khoản (D-047, MASTER_PLAN 9.6.1) ---
# off (mặc định): tắt — vẫn ghi nhận thu thủ công. mock: nhà cung cấp giả lập, có công cụ giả lập, KHÔNG tiền thật.
# test/live: nhà cung cấp thật (SePay). Thiếu khóa thì API dừng khởi động, không tự chuyển sang mock.
BANK_INTEGRATION_MODE=off
# BANK_PROVIDER=mock            # mock | sepay
# Khóa xác thực webhook (nhà cung cấp gửi header "Authorization: Apikey <khóa>"), ≥ 16 ký tự ngẫu nhiên. KHÔNG commit khóa thật.
# BANK_WEBHOOK_API_KEY=
# SePay: API token để lấy bù giao dịch bị lỡ (bắt buộc khi test/live). KHÔNG commit.
# SEPAY_API_TOKEN=
# SEPAY_API_BASE_URL=https://my.sepay.vn/userapi
# Mock: địa chỉ webhook mà công cụ giả lập gọi tới (mặc định chính API qua 127.0.0.1:API_PORT).
# BANK_MOCK_WEBHOOK_URL=

# --- Web ---
WEB_PORT=3000
# Next.js rewrite /api/* tới địa chỉ này (phía server, trình duyệt không gọi trực tiếp).
API_INTERNAL_URL=http://localhost:4000

# --- Seed (chỉ dev; seed từ chối chạy khi NODE_ENV=production) ---
SEED_OWNER_PASSWORD=dev-owner-pass-123
SEED_STAFF_PASSWORD=dev-staff-pass-123
